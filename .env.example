# react_fast_api/.env.example
# Copy this to .env and fill in your values for local development.
# In Databricks Apps, these are injected via app.yaml env section.

DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=your_warehouse_id
DATABRICKS_TOKEN=your_personal_access_token
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

DATABRICKS_CATALOG=system
DATABRICKS_CACHE_TTL=7200
DATABRICKS_QUERY_TIMEOUT=60
DATABRICKS_POOL_SIZE=5


DEFAULT_THEME=dark

NOTEBOOK_NAME=FinOps DBX Developer Notebook
NOTEBOOK_BTN_LABEL=Open Developer Notebook
NOTEBOOK_ID=
NOTEBOOK_WORKSPACE_PATH=

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# CORS origins — for local dev; in Databricks Apps this is not needed
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
